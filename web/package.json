{
  "name": "wiselabz-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "predev": "orval --config ./orval.config.ts",
    "dev": "vite",
    "prebuild": "orval --config ./orval.config.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "gen:api": "orval --config ./orval.config.ts",
    "gen:api:watch": "orval --config ./orval.config.ts --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/big-shoulders-text": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.103.2",
    "@types/diff": "^8.0.0",
    "@uiw/react-codemirror": "^4.25.11",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "i18next": "^26.4.2",
    "match-sorter": "^8.3.0",
    "mermaid": "^12.0.0",
    "motion": "^13.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-grid-layout": "^2.2.4",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-grid-layout": "^2.1.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "orval": "^8.37.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
