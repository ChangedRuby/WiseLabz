{
  "name": "wiselabz-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "predev": "orval --config ./orval.config.ts",
    "dev": "vite",
    "prebuild": "orval --config ./orval.config.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "gen:api": "orval --config ./orval.config.ts",
    "gen:api:watch": "orval --config ./orval.config.ts --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.3",
    "@fontsource-variable/big-shoulders-text": "^5.3.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/space-mono": "^5.2.9",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/react-query": "^5.101.1",
    "@types/diff": "^7.0.2",
    "@uiw/react-codemirror": "^4.25.10",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "i18next": "^26.3.2",
    "match-sorter": "^8.3.0",
    "motion": "^12.42.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.2",
    "react-grid-layout": "^2.2.3",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
